---
import Base from "../../layouts/Base.astro";
import ArticleList from "../../components/ArticleList.astro";
import { allArticles } from "../../lib/articles";
import { site } from "../../site";
const all = await allArticles();
const jsonLd = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${site.name} resume articles`,
  url: `${site.url}/articles/`,
  hasPart: all.map((a) => ({ "@type": "Article", headline: a.data.title, url: `${site.url}/articles/${a.id}/` })),
}];
---
<Base title="Resume Guides: ATS, Formats, Examples, Job Search" description={`${all.length} free guides on writing an ATS-friendly resume, formats, examples by role, freshers, cover letters, Naukri and LinkedIn, for India and abroad.`} jsonLd={jsonLd}>
  <div class="wrap">
    <h1 style="margin-top:32px">Resume articles</h1>
    <p class="lead">{all.length} free guides on getting your resume past ATS and AI screening and in front of a person, for jobs in India and abroad.</p>
    <ArticleList articles={all} current="all" />
  </div>
</Base>
