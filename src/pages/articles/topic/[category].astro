---
import Base from "../../../layouts/Base.astro";
import ArticleList from "../../../components/ArticleList.astro";
import { allArticles } from "../../../lib/articles";
import { site, categories, type CategoryId } from "../../../site";

export async function getStaticPaths() {
  return Object.keys(categories).map((category) => ({ params: { category } }));
}
const id = Astro.params.category as CategoryId;
const c = categories[id];
const list = (await allArticles()).filter((a) => a.data.category === id);
const url = `${site.url}/articles/topic/${id}/`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: c.label,
    description: c.blurb,
    url,
    hasPart: list.map((a) => ({ "@type": "Article", headline: a.data.title, url: `${site.url}/articles/${a.id}/` })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${site.url}/` },
      { "@type": "ListItem", position: 2, name: "Articles", item: `${site.url}/articles/` },
      { "@type": "ListItem", position: 3, name: c.label, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: c.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---
<Base title={c.seoTitle} description={`${c.blurb} ${list.length} free guides from ${site.name}, for India and abroad.`} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb" style="margin-top:24px"><a href="/">Home</a> › <a href="/articles/">Articles</a> › {c.label}</nav>
    <h1 style="margin-top:12px">{c.label}</h1>
    <div class="hub-intro">{c.intro.map((p) => <p class="lead">{p}</p>)}</div>
    <ArticleList articles={list} current={id} />
    <section class="hub-faq">
      <h2>Common questions</h2>
      {c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  </div>
</Base>
