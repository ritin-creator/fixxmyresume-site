---
import Base from "../layouts/Base.astro";
import { links } from "../site";
---
<Base title="Page not found" description="This page does not exist." noindex>
  <div class="wrap narrow" style="padding:64px 20px;text-align:center">
    <h1>Page not found</h1>
    <p class="muted">The page you're looking for isn't here. Try the articles, or check your resume for free.</p>
    <p><a class="btn" href={links.check}>Check my resume free</a> <a class="btn btn-ghost" href="/articles/">Browse articles</a></p>
  </div>
</Base>
