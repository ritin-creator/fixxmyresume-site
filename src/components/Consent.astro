---
import { site, links } from "../site";
---
<div id="fmr-consent" class="consent" role="region" aria-label="Cookie notice" hidden>
  <p>We use cookies to measure our ads and improve FixxMyResume. Your resume is never shared. <a href={links.privacy}>Privacy policy</a></p>
  <div class="consent-actions">
    <button type="button" class="btn btn-small btn-ghost" data-consent="no">Decline</button>
    <button type="button" class="btn btn-small" data-consent="yes">Accept</button>
  </div>
</div>
<script is:inline define:vars={{ pixelId: site.metaPixelId }}>
(function () {
  var NAME = "fmr_consent";
  function get() { var m = document.cookie.match(/(?:^|; )fmr_consent=(yes|no)/); return m ? m[1] : null; }
  function set(v) {
    var host = location.hostname.endsWith("fixxmyresume.com") ? "; domain=.fixxmyresume.com" : "";
    document.cookie = NAME + "=" + v + "; path=/; max-age=" + 60 * 60 * 24 * 180 + "; SameSite=Lax; Secure" + host;
  }
  function loadPixel() {
    if (!pixelId || window.fbq) return;
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version="2.0";n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,"script","https://connect.facebook.net/en_US/fbevents.js");
    window.fbq("init", pixelId);
    window.fbq("track", "PageView");
  }
  var box = document.getElementById("fmr-consent");
  var c = get();
  if (c === "yes") loadPixel();
  else if (!c && box) box.hidden = false;
  if (box) box.addEventListener("click", function (e) {
    var b = e.target.closest("[data-consent]"); if (!b) return;
    var v = b.getAttribute("data-consent"); set(v); box.hidden = true;
    if (v === "yes") loadPixel();
  });
})();
</script>
