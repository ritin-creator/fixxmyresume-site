---
import { site, links, categories, regions } from "../site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="logo" href="/"><img class="logo-mark" src="/logo-icon.svg" alt="" width="30" height="30" /><span class="logo-text">Fixx<b>My</b>Resume</span></a>
      <p class="muted small">ATS-friendly resumes from your old resume or LinkedIn profile. Free check, ₹{site.priceInr} to fix.</p>
      <p class="muted small">Operated by {site.operatedBy}. Payments processed securely by Razorpay.</p>
    </div>
    <div>
      <h2 class="footer-h">Articles</h2>
      <ul class="plain">
        {Object.entries(regions).map(([id, r]) => <li><a href={`/articles/${id}/`}>{r.label}</a></li>)}
        {Object.entries(categories).map(([id, c]) => <li><a href={`/articles/topic/${id}/`}>{c.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Product</h2>
      <ul class="plain">
        <li><a href={links.check}>Free resume check</a></li>
        <li><a href="/about/">About us</a></li>
        <li><a href={links.login}>Log in</a></li>
        <li><a href={links.terms}>Terms</a></li>
        <li><a href={links.privacy}>Privacy</a></li>
        <li><a href={links.refund}>Refund policy</a></li>
        <li><a href={links.delivery}>Delivery policy</a></li>
        <li><a href={links.contact}>Contact us</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap muted small footer-base">© {year} {site.name}. Not affiliated with any job portal or applicant tracking system named on this site.</div>
</footer>
